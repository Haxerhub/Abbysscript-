local function UpdateWalkSpeed()
    local val = tonumber(SpeedInput.Text)
    local char = Player.Character
    if val and char and char:FindFirstChildOfClass("Humanoid") then
        char:FindFirstChildOfClass("Humanoid").WalkSpeed = val
    end
end

ApplySpeedBtn.MouseButton1Click:Connect(UpdateWalkSpeed)
SpeedInput.FocusLost:Connect(function(enter) if enter then UpdateWalkSpeed() end end)
PlusBtn.MouseButton1Click:Connect(function()
    SpeedInput.Text = tostring((tonumber(SpeedInput.Text) or 16) + 10)
    UpdateWalkSpeed()
end)
MinusBtn.MouseButton1Click:Connect(function()
    SpeedInput.Text = tostring(math.max(0, (tonumber(SpeedInput.Text) or 16) - 10))
    UpdateWalkSpeed()
end)

