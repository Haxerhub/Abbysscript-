local function CreateButton(parent, pos, size, text, color)
    local btn = Instance.new("TextButton", parent)
    btn.BackgroundColor3 = color or CONFIG.Theme.Secondary
    btn.Position = pos
    btn.Size = size
    btn.Text = text
    btn.TextColor3 = CONFIG.Theme.Text
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

local function CreateTextBox(parent, pos, size, placeholder, defaultText)
    local box = Instance.new("TextBox", parent)
    box.BackgroundColor3 = CONFIG.Theme.InputBg
    box.Position = pos
    box.Size = size
    box.PlaceholderText = placeholder
    box.Text = defaultText
    box.TextColor3 = CONFIG.Theme.Text
    box.TextSize = 14
    box.Font = Enum.Font.SourceSans
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    return box
end

